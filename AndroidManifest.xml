<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.narish61.amefix"
    android:versionCode="26112609"
    android:versionName="2.0.0">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.KILL_BACKGROUND_PROCESSES" />

    <queries>
        <package android:name="com.apple.android.music" />
    </queries>

    <application
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:allowBackup="false"
        android:localeConfig="@xml/locales_config">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@android:style/Theme.DeviceDefault.Light.NoActionBar"
            android:label="@string/app_name">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".MoreToolsActivity"
            android:exported="false"
            android:theme="@android:style/Theme.DeviceDefault.Light.NoActionBar"
            android:label="@string/more_tools_title" />

        <activity
            android:name=".AboutActivity"
            android:exported="false"
            android:theme="@android:style/Theme.DeviceDefault.Light.NoActionBar"
            android:label="@string/about_title" />

        <receiver
            android:name=".FontStateReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="com.narish61.amefix.QUERY_FONT_STATE" />
            </intent-filter>
        </receiver>

        <provider
            android:name=".FontProvider"
            android:authorities="com.narish61.amefix.fontprovider"
            android:exported="true"
            android:grantUriPermissions="true" />

        <meta-data
            android:name="xposedmodule"
            android:value="true" />
        <meta-data
            android:name="xposeddescription"
            android:value="修复 Apple Music 使用有线耳机不能耳机操控至上一首&#10;Fixes wired headset controls in Apple Music not skipping to the previous track" />
        <meta-data
            android:name="xposedminversion"
            android:value="93" />
        <meta-data
            android:name="xposedscope"
            android:value="com.apple.android.music" />
    </application>
</manifest>
